# Copy to .env and edit. Every value below is a default the API already uses, so
# an empty .env still boots; the only one you should really change is
# JWT_SECRET_KEY. Generate one with: .\scripts\generate-secret.ps1

# ---- Database ----
POSTGRES_USER=agentlens
POSTGRES_PASSWORD=agentlens
POSTGRES_DB=agentlens
POSTGRES_PORT=5432
# Docker / production:
DATABASE_URL=postgresql+asyncpg://agentlens:agentlens@localhost:5432/agentlens
# Windows local development without Docker (run the API from apps/api):
# DATABASE_URL=sqlite+aiosqlite:///./agentlens.db

# ---- Redis (refresh-token revocation, password-reset tokens) ----
# Docker / production:
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
# Local development without Redis installed. Tokens live in-process, so they are
# lost on restart and cannot be revoked across workers. Not for production.
# REDIS_URL=memory://

# ---- API ----
API_PORT=8000
JWT_SECRET_KEY=change-me-run-scripts/generate-secret.ps1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Comma-separated exact origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# "production" enables HSTS. Terminate TLS in front of the API.
ENVIRONMENT=development
DEBUG=false

# ---- Web ----
WEB_PORT=3000
# Baked into the frontend bundle at build time, so it must be reachable from the
# browser rather than from inside the container network.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- LLM-as-judge evaluator ----
# Leave OPENAI_API_KEY empty to use the offline scoring heuristic instead. Any
# OpenAI-compatible endpoint works via JUDGE_BASE_URL.
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o-mini
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_TIMEOUT_SECONDS=30
# Cap on subjects scored in a single evaluation run.
MAX_EVALUATION_ITEMS=2000

# ---- Request guards ----
# Sliding window per client IP. Turn off for bulk imports and seeding.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1200
RATE_LIMIT_WINDOW_SECONDS=60
# Requests with a larger body get 413. Default 5 MiB.
MAX_REQUEST_BYTES=5242880

# ---- Live stream (server-sent events) ----
STREAM_POLL_SECONDS=2.0
# Connections close after this long and the browser reconnects, so a forgotten
# dashboard tab cannot hold a connection open forever.
STREAM_MAX_SECONDS=900

# ---- Demo scripts and examples ----
AGENTLENS_API_KEY=
AGENTLENS_API_URL=http://localhost:8000
